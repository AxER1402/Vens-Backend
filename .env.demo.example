# =============================================================================
# .env.demo.example — Configuración del entorno de DEMOSTRACIÓN
# Centro Médico de Flebología — Vens
# =============================================================================
#   cp .env.demo.example .env.demo
#
# Edite lo que diga CAMBIAR. NUNCA copie aquí valores de .env.prod: la demo
# lleva su propia clave, sus propias contraseñas y ningún acceso a R2, al
# correo de la clínica ni a Google.
# =============================================================================

APP_NAME="Clínica Doctora Yojana Mendoza - Flebología"
APP_ENV=production

# CAMBIAR — una clave NUEVA, distinta a la de producción:  make demo-key
APP_KEY=

APP_DEBUG=false

# CAMBIAR — el subdominio de la demo. Debe contener "demo": DemoSeeder se
# niega a sembrar un servidor cuyo APP_URL no lo tenga.
APP_URL=https://demo.clinica-vens.com

APP_TIMEZONE=America/Guatemala
APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_GT

# Puerto local (solo 127.0.0.1) al que apunta el proxy del subdominio.
# Debe ser distinto al de producción.
APP_PORT=8081

# ── Base de datos (propia de la demo) ────────────────────────────────────────
DB_CONNECTION=mysql
DB_DATABASE=vens_demo
DB_USERNAME=vens_demo
# CAMBIAR las dos
DB_PASSWORD=
DB_ROOT_PASSWORD=

# ── Redis (propio de la demo) ────────────────────────────────────────────────
# CAMBIAR
REDIS_PASSWORD=
REDIS_CLIENT=phpredis
CACHE_STORE=redis
CACHE_PREFIX=vens_demo_
QUEUE_CONNECTION=redis

# ── WhatsApp ─────────────────────────────────────────────────────────────────
# La demo no tiene contenedor de WhatsApp; el token solo existe para que el
# arranque no se queje. Cualquier valor sirve.
WHATSAPP_TOKEN=demo-sin-whatsapp
WHATSAPP_CODIGO_PAIS=502

# ── Respaldos en R2: APAGADOS ────────────────────────────────────────────────
# Vacíos a propósito: con R2_BUCKET o RESPALDO_CLAVE vacíos no se respalda,
# y la base ficticia jamás llega al bucket de la clínica.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=
RESPALDO_CLAVE=

# ── Sesiones ─────────────────────────────────────────────────────────────────
SESSION_DRIVER=redis
SESSION_LIFETIME=480
SESSION_ENCRYPT=true
SESSION_COOKIE=vens_demo_session
SANCTUM_TOKEN_INACTIVITY=240

CORS_ALLOWED_ORIGINS=

# ── Correo: solo al log ──────────────────────────────────────────────────────
MAIL_MAILER=log
MAIL_FROM_ADDRESS=demo@example.com
MAIL_FROM_NAME="${APP_NAME}"

FILESYSTEM_DISK=local
LOG_LEVEL=error
RUN_MIGRATIONS=true

# ── Membrete de los informes ─────────────────────────────────────────────────
REPORTE_CENTRO_NOMBRE="CLÍNICA DOCTORA YOJANA MENDOZA"
REPORTE_CENTRO_ESPECIALIDAD="FLEBOLOGÍA"
REPORTE_CENTRO_DIRECCION=""
REPORTE_CENTRO_TELEFONO=""
REPORTE_CENTRO_CORREO=""
REPORTE_CENTRO_LOGO=img/isotipo.png
REPORTE_MEDICO_NOMBRE=""
REPORTE_MEDICO_COLEGIADO=""

# ── Correos de las cuentas de la demo ──────────────────────────────────────
# Opcionales. Si se dejan vacíos, las cuentas usan admin@vens.com,
# medico@vens.com y recepcion@vens.com. Van aquí y no en el código porque
# pueden ser correos reales y el repositorio es público. Se aplican al
# sembrar (make demo-reset), después de recrear el contenedor (make demo-up).
DEMO_CORREO_ADMIN=
DEMO_CORREO_MEDICO=
DEMO_CORREO_RECEPCION=

# ── Inicio de sesión con Google ──────────────────────────────────────────────
# Vacío: el botón responde que no está disponible. Para activarlo, el mismo
# Client ID de .env.prod (no es secreto) y agregar https://demo.<dominio> en
# "Orígenes autorizados de JavaScript" de ese Client ID en Google Cloud Console.
# Se compila dentro de la SPA: después de cambiarlo hay que hacer make demo-build.
GOOGLE_CLIENT_ID=
