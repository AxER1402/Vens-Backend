# =============================================================================
# .env.example — Plantilla de Variables de Entorno
# Centro Médico de Flebología — Backend Vens
# =============================================================================
# Este archivo es una PLANTILLA. No contiene valores reales/secretos.
# Debe ser commiteado al repositorio (git) para que otros desarrolladores
# sepan qué variables configurar.
#
# Para usar: copiar este archivo como .env y ajustar los valores
#   cp .env.example .env
#
# IMPORTANTE: El archivo .env NUNCA debe commitearse al repositorio.
#             Ya está incluido en .gitignore automáticamente por Laravel.
# =============================================================================

# ── Aplicación Laravel ────────────────────────────────────────────────────────

# Nombre de la aplicación (aparece en emails, logs, etc.)
APP_NAME="Centro Médico Vens - Flebología"

# Entorno de ejecución
# Valores posibles: local | testing | staging | production
APP_ENV=local

# Clave de cifrado de la aplicación (32 caracteres aleatorios en base64)
# GENERAR con: docker-compose exec app php artisan key:generate
# NUNCA compartir esta clave. Cifra sesiones, cookies y datos sensibles.
APP_KEY=

# Modo de depuración
# true  = Mostrar errores detallados (solo en desarrollo)
# false = Ocultar errores (OBLIGATORIO en producción)
APP_DEBUG=true

# URL base de la aplicación (sin trailing slash)
APP_URL=http://localhost:8000

# URL base del frontend (React + Vite), sin trailing slash.
# Se usa para armar los enlaces enviados por correo, como el de
# restablecimiento de contraseña: FRONTEND_URL/restablecer-contrasena?token=...
FRONTEND_URL=http://localhost:5173

# Zona horaria de la aplicación
APP_TIMEZONE=America/Guatemala

# Idioma por defecto
APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_GT

# ── Base de Datos (MySQL) ─────────────────────────────────────────────────────
# Laravel se conecta a MySQL usando estas variables.
# El host "mysql" es el nombre del servicio en docker-compose.yml.
# Docker resuelve automáticamente ese nombre a la IP del contenedor MySQL.

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=vens_flebologia
DB_USERNAME=vens_user
DB_PASSWORD=vens_password_2024

# Contraseña de root de MySQL (solo para administración via phpMyAdmin)
DB_ROOT_PASSWORD=root_vens_2024

# ── Redis (Caché y Colas) ─────────────────────────────────────────────────────
# Redis se usa para caché, sesiones y colas de trabajos.

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=redis_vens_2024
REDIS_CLIENT=phpredis

# ── Configuración de Caché ────────────────────────────────────────────────────
# Driver de caché (redis es más rápido que file para sistemas médicos)
CACHE_STORE=redis
CACHE_PREFIX=vens_

# ── Configuración de Sesiones ─────────────────────────────────────────────────
# Usar Redis para sesiones (mejor en entornos multi-servidor)
SESSION_DRIVER=redis
SESSION_LIFETIME=480        # Minutos de inactividad antes de cerrar sesión (8 horas)
SESSION_ENCRYPT=true        # Cifrar datos de sesión (importante en sistema médico)
SESSION_COOKIE=vens_session

# ── Colas de Trabajos (Jobs/Queues) ──────────────────────────────────────────
# Las colas procesan tareas en segundo plano:
# envío de emails, generación de reportes PDF, notificaciones, etc.
QUEUE_CONNECTION=redis

# ── Correo Electrónico ────────────────────────────────────────────────────────
# Configuración del servidor de email para:
# - Confirmaciones de citas
# - Recordatorios a pacientes
# - Notificaciones al personal médico
#
# Configuración con Gmail. Requiere una CONTRASEÑA DE APLICACIÓN de Google
# (la contraseña normal de la cuenta NO sirve):
#   1. Activar la Verificación en 2 pasos: https://myaccount.google.com/security
#   2. Generar la clave en: https://myaccount.google.com/apppasswords
#   3. Copiarla SIN espacios en MAIL_PASSWORD
#
# MAIL_FROM_ADDRESS debe ser la misma cuenta de MAIL_USERNAME, o Gmail
# reescribe el remitente y el correo puede terminar en spam.
#
# Nota: en Laravel 11+ la variable es MAIL_SCHEME, no MAIL_ENCRYPTION.
# Con el puerto 587 no hace falta definirla (usa STARTTLS automáticamente);
# para el puerto 465 hay que añadir MAIL_SCHEME=smtps.
#
# Límite de una cuenta gratuita de Gmail: ~500 correos al día.
# Alternativa para desarrollo: MAIL_MAILER=log escribe los correos en
# storage/logs/laravel.log en lugar de enviarlos.
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=tucuenta@gmail.com
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="tucuenta@gmail.com"
MAIL_FROM_NAME="${APP_NAME}"

# ── Puertos de Servicios Docker ───────────────────────────────────────────────
# Personalizar si los puertos por defecto están ocupados en tu sistema
NGINX_PORT=8000       # Acceso a la API: http://localhost:8000
PMA_PORT=8080         # phpMyAdmin: http://localhost:8080

# ── Laravel Sanctum (Autenticación API) ──────────────────────────────────────
# Sanctum maneja la autenticación para SPAs (Single Page Applications).
# El frontend React/Vue puede autenticarse usando tokens Bearer.
SANCTUM_STATEFUL_DOMAINS=localhost:3000,localhost:5173,127.0.0.1:3000

# ── Filesystem / Almacenamiento ───────────────────────────────────────────────
# Dónde se almacenan los archivos subidos (documentos clínicos, fotos)
# local = en el servidor (desarrollo)
# s3    = Amazon S3 (recomendado para producción)
FILESYSTEM_DISK=local

# ── Logging ───────────────────────────────────────────────────────────────────
# Canal de logs de Laravel
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug       # En producción usar: error
