# =============================================================================
# .env.prod.example — Configuración de PRODUCCIÓN (imagen unificada)
# Centro Médico de Flebología — Vens
# =============================================================================
#   cp .env.prod.example .env.prod
#
# Y edite abajo TODO lo que diga CAMBIAR. Este archivo no se versiona: el
# .gitignore lo excluye porque lleva las contraseñas reales de la clínica.
#
# Ojo con las diferencias respecto de .env.example (desarrollo):
#   - No aparecen DB_HOST, DB_PORT, REDIS_HOST ni REDIS_PORT: los fija
#     docker-compose.prod.yml con los nombres de los servicios de Docker.
#   - No aparece FRONTEND_URL: al servirse todo desde el mismo dominio, vale
#     lo mismo que APP_URL y Compose lo copia solo.
#   - No aparece NGINX_PORT ni PMA_PORT: no hay phpMyAdmin y el puerto de la
#     aplicación se llama APP_PORT.
# =============================================================================

# ── Aplicación ───────────────────────────────────────────────────────────────
APP_NAME="Clínica Doctora Yojana Mendoza - Flebología"

# production activa las optimizaciones y desactiva las ayudas de depuración.
APP_ENV=production

# CAMBIAR — genérela con:  make prod-key
# Sin esto el contenedor no arranca: es la clave con la que se cifran las
# sesiones y los datos sensibles. Si se pierde, las sesiones dejan de leerse.
APP_KEY=

# false SIEMPRE en producción. En true, cualquier error mostraría al usuario
# las rutas del servidor y las credenciales de la base de datos.
APP_DEBUG=false

# CAMBIAR — el dominio público desde el que se entra al sistema.
# Con dominio propio y HTTPS sería, por ejemplo: https://clinica-vens.com
APP_URL=http://localhost

APP_TIMEZONE=America/Guatemala
APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_GT

# Puerto del host donde escucha la aplicación. En un servidor con dominio
# propio se deja en 80 y se pone delante un proxy con el certificado TLS.
APP_PORT=80

# ── Base de datos ────────────────────────────────────────────────────────────
# DB_HOST y DB_PORT los pone docker-compose.prod.yml (servicio "mysql").
DB_CONNECTION=mysql
DB_DATABASE=vens_flebologia

# CAMBIAR las tres — no deje las contraseñas de ejemplo del entorno de
# desarrollo. Son historias clínicas: use contraseñas largas y únicas.
DB_USERNAME=vens_user
DB_PASSWORD=
DB_ROOT_PASSWORD=

# ── Redis ────────────────────────────────────────────────────────────────────
# REDIS_HOST y REDIS_PORT los pone docker-compose.prod.yml (servicio "redis").
# CAMBIAR la contraseña.
REDIS_PASSWORD=
REDIS_CLIENT=phpredis

CACHE_STORE=redis
CACHE_PREFIX=vens_
QUEUE_CONNECTION=redis

# ── Sesiones ─────────────────────────────────────────────────────────────────
SESSION_DRIVER=redis
SESSION_LIFETIME=480          # Minutos de inactividad antes de cerrar sesión
SESSION_ENCRYPT=true
SESSION_COOKIE=vens_session

# Minutos de inactividad tras los que se invalida el token de Sanctum.
SANCTUM_TOKEN_INACTIVITY=60

# ── CORS ─────────────────────────────────────────────────────────────────────
# Se deja vacío a propósito: con la imagen unificada el frontend y la API
# comparten dominio, así que no hay ninguna petición entre orígenes que
# permitir. Solo hace falta si algún día se conecta otro cliente desde otro
# dominio, y entonces se listan ahí separados por comas.
CORS_ALLOWED_ORIGINS=

# ── Correo ───────────────────────────────────────────────────────────────────
# Lo usa la recuperación de contraseña. CAMBIAR usuario y contraseña.
# Con Gmail hace falta una "contraseña de aplicación", no la del correo.
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

# ── Archivos y registro ──────────────────────────────────────────────────────
FILESYSTEM_DISK=local

# LOG_CHANNEL lo fija docker-compose.prod.yml en "stderr" para que los
# registros salgan por  docker compose logs  en vez de acumularse en disco.
LOG_LEVEL=error

# ── Migraciones al arrancar ──────────────────────────────────────────────────
# El contenedor aplica las migraciones pendientes cada vez que arranca.
# Poner false solo si algún día hay más de una réplica de la aplicación.
RUN_MIGRATIONS=true

# ── Membrete de los informes ─────────────────────────────────────────────────
# Estos son los valores de arranque. Una vez desplegado, se editan desde la
# pantalla de ajustes del sistema y quedan guardados en la base de datos.
REPORTE_CENTRO_NOMBRE="CLÍNICA DOCTORA YOJANA MENDOZA"
REPORTE_CENTRO_ESPECIALIDAD="FLEBOLOGÍA"
REPORTE_CENTRO_DIRECCION=""
REPORTE_CENTRO_TELEFONO=""
REPORTE_CENTRO_CORREO=""
REPORTE_CENTRO_LOGO=img/isotipo.png
REPORTE_MEDICO_NOMBRE=""
REPORTE_MEDICO_COLEGIADO=""
